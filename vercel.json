{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?_path=$1"
    },
    {
      "src": "/api",
      "dest": "/api/index.js?_path=status"
    },
    {
      "src": "/admin/leads",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin.html",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/?",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/index.html"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
