# ==============================================================================
# Z R INTERIOR DESIGN — ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env and configure in Vercel Project Settings > Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_BASE_URL=https://zr-interior-landing-page.vercel.app

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (Fee: ₹199 INR = 19900 paise)
# ------------------------------------------------------------------------------
# Obtain keys from: https://dashboard.razorpay.com/app/keys
# Start in Test Mode (rzp_test_...) then switch to Live (rzp_live_...) for production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Webhook Secret configured in Razorpay Dashboard > Settings > Webhooks
# Set Webhook URL to: https://YOUR-VERCEL-DOMAIN/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Server-enforced consultation amount in paise (19900 paise = ₹199 INR)
CONSULTATION_AMOUNT_PAISE=19900

# ------------------------------------------------------------------------------
# 2. CALENDLY SCHEDULING (45-Minute Consultation)
# ------------------------------------------------------------------------------
# Direct 45-minute consultation event type link
CALENDLY_URL=https://calendly.com/zrinteriordesign/45min

# Optional Calendly Webhook Signing Key (for /api/calendly/webhook)
# Obtain from Calendly Developer Portal > Webhooks
CALENDLY_WEBHOOK_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 3. WHATSAPP BUSINESS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# WhatsApp destination number for prefilled consultation booking chat
WHATSAPP_BUSINESS_PHONE=917878588859

# Optional Meta Cloud API credentials (if automated background template messages are enabled)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Supabase Project Dashboard: https://supabase.com/dashboard/project/udetsffqshoxanyviyht
# Project Reference: udetsffqshoxanyviyht
# Keys: Supabase Dashboard > Settings > API (or Project Settings > API Keys)
#
# 1. Supabase Project URL:
SUPABASE_URL=https://udetsffqshoxanyviyht.supabase.co
#
# 2. Supabase Replacement Secret Key (formerly service_role key):
# CRITICAL: Server-side only! Used by /api serverless functions to securely capture leads and verify payments.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-replacement-secret-key-here
# Alias supported: SUPABASE_SECRET_KEY=your-supabase-replacement-secret-key-here
#
# 3. Supabase Publishable Key (formerly anon key):
SUPABASE_ANON_KEY=your-supabase-publishable-key-here
# Alias supported: SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# ------------------------------------------------------------------------------
# 5. ADMIN LEADS DASHBOARD AUTHENTICATION (/admin/leads)
# ------------------------------------------------------------------------------
# Server-side credentials for protected admin leads management portal
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_SESSION_SECRET=your-random-32-char-session-secret-here

# ------------------------------------------------------------------------------
# 6. META ADS CONVERSIONS & PIXEL (OPTIONAL)
# ------------------------------------------------------------------------------
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
